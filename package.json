{
  "name": "lid-top",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.12.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run media:prepare && vite",
    "build": "npm run media:prepare && vite build && node scripts/prerender.mjs && npm run static:validate",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "media:prepare": "node scripts/prepare-media.mjs",
    "static:validate": "node scripts/validate-static.mjs"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@solidjs/web": "2.0.0-rc.1",
    "solid-js": "2.0.0-rc.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "@playwright/test": "1.62.1",
    "@solidjs/vite-plugin": "3.0.0-next.30",
    "@types/node": "26.2.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "sharp": "0.35.3",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.11"
  }
}
